---
import type { SiteContent } from '../content/types';

interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
---
<section id="about" class="section about reveal">
  <div class="wrap">
    <span class="eyebrow">{content.about.heading}</span>
    <h2 class="section-title">{content.about.careerHeading}</h2>

    <ol data-testid="career-timeline" class="timeline">
      {content.about.career.map((entry) => (
        <li class="timeline__item">
          <strong class="timeline__role">{entry.role}</strong>
          <span class="timeline__company">{entry.company}</span>
          <span class="timeline__period">{entry.period}</span>
          <span class="timeline__location">{entry.location}</span>
        </li>
      ))}
    </ol>

    <div class="about__grid">
      <div class="about__block">
        <h3>{content.about.educationHeading}</h3>
        <p>{content.about.education}</p>
      </div>

      <div class="about__block">
        <h3>{content.about.certificationsHeading}</h3>
        <ul data-testid="certifications" class="cert-list">
          {content.about.certifications.map((cert) => (
            <li>
              <span>{cert.name}</span>
              <span class="cert-list__valid">{cert.validUntil}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-xs) var(--space-m);
    padding-block: var(--space-s);
    border-top: var(--border-width) solid var(--surface-line);
  }

  .timeline__item:last-child {
    border-bottom: var(--border-width) solid var(--surface-line);
  }

  .timeline__role {
    font-weight: 600;
  }

  .timeline__company {
    color: var(--text-muted);
  }

  .timeline__period,
  .timeline__location {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
    text-align: right;
  }

  .about__grid {
    margin-top: var(--space-2xl);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-xl);
  }

  .about__block h3 {
    font-size: var(--step-1);
    margin-bottom: var(--space-s);
  }

  .about__block p {
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .cert-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .cert-list li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-xs);
    border-top: var(--border-width) solid var(--surface-line);
  }

  .cert-list__valid {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .timeline__item {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .timeline__period,
    .timeline__location {
      text-align: left;
    }
  }
</style>
