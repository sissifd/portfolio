---
import type { SiteContent } from '../content/types';

interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
---
<section id="contact" class="section reveal">
  <div class="wrap contact__inner">
    <h2 class="section-title">{content.contact.heading}</h2>
    <div class="contact__links">
      <a href={`mailto:${content.contact.email}`} data-testid="contact-email" class="contact__link">{content.contact.email}</a>
      <a href={content.contact.linkedin} data-testid="contact-linkedin" class="contact__link">LinkedIn</a>
      <a href={content.contact.github} data-testid="contact-github" class="contact__link">GitHub</a>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    padding-block-end: var(--space-2xl);
  }

  .contact__links {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
  }

  .contact__link {
    padding: 0.7em 1.3em;
    border: var(--border-width) solid var(--surface-line);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .contact__link:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }
</style>
